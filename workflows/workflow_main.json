      "parameters": {
        "jsCode": "const items = $input.all();\nlet finalResponse = {\n  success: false,\n  data: {},\n  tool_calls: [],\n  error: \"\",\n  is_handoff: false, // 👈 新增一个字段，用来标记是否转人工\n  trace_id: \"trace-\" + Date.now()\n};\n\nfor (const item of items) {\n  if (item.json && item.json.success !== undefined) {\n    if (item.json.success) {\n      finalResponse.success = true;\n      finalResponse.data = { ...finalResponse.data, ...item.json.data };\n    } else {\n      finalResponse.error = item.json.error || finalResponse.error;\n    }\n  } else {\n    finalResponse.success = true;\n    finalResponse.data = { ...finalResponse.data, ...item.json };\n  }\n}\n\n// 👈 检查 Dify 的回复里是否包含暗号\nif (finalResponse.data && finalResponse.data.answer && finalResponse.data.answer.includes(\"[SYSTEM_ACTION: HANDOFF_REQUESTED]\")) {\n  finalResponse.is_handoff = true;\n}\n\nreturn [{ json: finalResponse }];"
      },
