      "name": "转人工通知",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // 安全容错取值：优先从当前输入拿，拿不到再去上游节点找\n  let userId = data.user_id;\n  let sessionId = data.session_id;\n  \n  if (!userId || !sessionId) {\n    try {\n      const editFields = $('Edit Fields').first();\n      userId = userId || editFields.json.user_id || \"unknown_user\";\n      sessionId = sessionId || editFields.json.session_id || \"unknown_session\";\n    } catch (e) {\n      userId = userId || \"unknown_user\";\n      sessionId = sessionId || \"unknown_session\";\n    }\n  }\n  \n  const reason = data.reason || \"用户主动请求转人工\";\n  \n  // 构造飞书交互式卡片内容（高级卡片）\n  const cardContent = {\n    config: {\n      wide_screen_mode: true\n    },\n    header: {\n      template: \"red\", // 红色标题，警示客服\n      title: {\n        tag: \"plain_text\",\n        content: \"🚨 客服升级请求\"\n      }\n    },\n    elements: [\n      {\n        tag: \"markdown\",\n        content: `**用户ID**: ${userId}\\n**会话ID**: ${sessionId}`\n      },\n      {\n        tag: \"hr\" // 分割线\n      },\n      {\n        tag: \"markdown\",\n        content: `**转人工原因**: ${reason}`\n      },\n      {\n        tag: \"hr\"\n      },\n      {\n        tag: \"markdown\",\n        content: `**时间**: ${new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' })}`\n      }\n    ]\n  };\n\n  results.push({\n    json: {\n      // 飞书 API 要求的完整 Body\n      feishu_body: {\n        receive_id: "YOUR_RECEIVE_ID", // ⚠️ 替换为你真实的飞书客服群 ID\n        msg_type: \"interactive\", // 👈 固定为交互式卡片\n        content: JSON.stringify(cardContent) // 👈 卡片内容必须序列化成字符串\n      },\n      // 保留数据供下游使用\n      user_id: userId,\n      session_id: sessionId,\n      reason: reason,\n      user_reply: \"好的，正在为您转接人工客服，请稍候...\"\n    }\n  });\n}\n\nreturn results;"
      },
